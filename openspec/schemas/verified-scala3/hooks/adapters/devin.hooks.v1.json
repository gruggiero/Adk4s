{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "./openspec/schemas/verified-scala3/hooks/gate.sh --event session-start --format hook-json"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "./openspec/schemas/verified-scala3/hooks/gate.sh --event prompt-submit --format hook-json"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "./openspec/schemas/verified-scala3/hooks/gate.sh --event post-edit --format hook-json"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "./openspec/schemas/verified-scala3/hooks/gate.sh --event completion --format hook-json"
        }
      ]
    }
  ]
}
